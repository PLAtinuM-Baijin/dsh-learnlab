{
  "name": "dsh-learnlab",
  "version": "0.1.0",
  "description": "把课件变成可以边看边问、边问边记的学习空间：原样浏览 PPT、按页提问、页码锚定笔记、涂画、双课件对比、独立翻译通道。A deck-centric study workspace plugin for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pptx",
    "slides",
    "study",
    "notes"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0",
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "THIRD-PARTY-NOTICES.md",
    "locale/*.json",
    "src/**/*.js",
    "src/**/*.jsx"
  ],
  "scripts": {
    "build": "node build/build.mjs",
    "check": "node --check index.js && node --check client.js",
    "test": "node test/smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "lucide-react": "^0.470.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
